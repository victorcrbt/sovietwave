  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#555577cc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment block",
      "scope": "comment.block",
      "settings": {
        "foreground": "#555577cc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#FF8899"
      }
    },
    {
      "name": "String quoted",
      "scope": [
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FF8899"
      }
    },
    {
      "name": "Import module path",
      "scope": [
        "string.quoted.double.ts",
        "string.quoted.single.ts",
        "string.quoted.double.tsx",
        "string.quoted.single.tsx",
        "string.quoted.double.js",
        "string.quoted.single.js",
        "string.quoted.double.jsx",
        "string.quoted.single.jsx",
        "meta.import string.quoted",
        "meta.import.ts string",
        "meta.import.tsx string"
      ],
      "settings": {
        "foreground": "#c7bfa3"
      }
    },
    {
      "name": "Punctuation string",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#c86b6b"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#b8944d"
      }
    },
    {
      "name": "Built-in constant",
